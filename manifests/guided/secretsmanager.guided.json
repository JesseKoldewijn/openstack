{
  "schemaVersion": "1.2",
  "service": "secretsmanager",
  "protocol": "json_target",
  "inputs": [
    { "name": "secret_name",  "type": "string", "required": true,  "description": "Secret name" },
    { "name": "secret_value", "type": "string", "required": false, "description": "Secret value (default: studio-secret-value)" }
  ],
  "flows": [
    {
      "id": "l1-basic",
      "level": "L1",
      "steps": [
        {
          "id": "create-secret",
          "title": "Create secret",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "secretsmanager.CreateSecret", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"Name\":\"{{inputs.secret_name}}\",\"SecretString\":\"{{inputs.secret_value}}\"}"
          },
          "captures": [
            { "name": "secret_arn",  "source": "ARN" },
            { "name": "secret_name", "source": "Name" }
          ],
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        },
        {
          "id": "get-secret",
          "title": "Get secret value",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "secretsmanager.GetSecretValue", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"SecretId\":\"{{captures.secret_name}}\"}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }],
          "error_guidance": "Secret not found — verify the create step succeeded."
        },
        {
          "id": "put-secret-value",
          "title": "Update secret value",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "secretsmanager.PutSecretValue", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"SecretId\":\"{{captures.secret_name}}\",\"SecretString\":\"updated-by-studio\"}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        },
        {
          "id": "describe-secret",
          "title": "Describe secret",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "secretsmanager.DescribeSecret", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"SecretId\":\"{{captures.secret_name}}\"}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        }
      ],
      "cleanup": [
        {
          "id": "delete-secret",
          "title": "Delete secret",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "secretsmanager.DeleteSecret", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"SecretId\":\"{{captures.secret_name}}\",\"ForceDeleteWithoutRecovery\":true}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        }
      ]
    }
  ]
}
