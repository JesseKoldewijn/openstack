{
  "schemaVersion": "1.2",
  "service": "ssm",
  "protocol": "json_target",
  "inputs": [
    { "name": "param_name",  "type": "string", "required": true,  "description": "SSM parameter name (without leading slash)" },
    { "name": "param_value", "type": "string", "required": false, "description": "Parameter value (default: studio-value)" }
  ],
  "flows": [
    {
      "id": "l1-basic",
      "level": "L1",
      "steps": [
        {
          "id": "put-parameter",
          "title": "Put parameter",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "AmazonSSM.PutParameter", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"Name\":\"/{{inputs.param_name}}\",\"Type\":\"String\",\"Value\":\"{{inputs.param_value}}\",\"Overwrite\":true}"
          },
          "captures": [{ "name": "param_name", "source": "inputs.param_name" }],
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        },
        {
          "id": "get-parameter",
          "title": "Get parameter",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "AmazonSSM.GetParameter", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"Name\":\"/{{captures.param_name}}\",\"WithDecryption\":false}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }],
          "error_guidance": "Parameter not found — verify the put-parameter step succeeded."
        },
        {
          "id": "put-parameter-updated",
          "title": "Update parameter",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "AmazonSSM.PutParameter", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"Name\":\"/{{captures.param_name}}\",\"Type\":\"String\",\"Value\":\"updated-by-studio\",\"Overwrite\":true}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        },
        {
          "id": "describe-parameters",
          "title": "Describe parameters",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "AmazonSSM.DescribeParameters", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"Filters\":[{\"Key\":\"Name\",\"Values\":[\"/{{captures.param_name}}\"]}]}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        }
      ],
      "cleanup": [
        {
          "id": "delete-parameter",
          "title": "Delete parameter",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "AmazonSSM.DeleteParameter", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"Name\":\"/{{captures.param_name}}\"}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        }
      ]
    }
  ]
}
