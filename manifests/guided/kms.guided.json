{
  "schemaVersion": "1.2",
  "service": "kms",
  "protocol": "json_target",
  "inputs": [
    { "name": "key_description", "type": "string", "required": false, "description": "Description for the KMS key (default: studio-test-key)" }
  ],
  "flows": [
    {
      "id": "l1-basic",
      "level": "L1",
      "steps": [
        {
          "id": "create-key",
          "title": "Create key",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "TrentService.CreateKey", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"Description\":\"{{inputs.key_description}}\",\"KeyUsage\":\"ENCRYPT_DECRYPT\"}"
          },
          "captures": [
            { "name": "key_id",  "source": "KeyMetadata.KeyId" },
            { "name": "key_arn", "source": "KeyMetadata.Arn" }
          ],
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        },
        {
          "id": "encrypt",
          "title": "Encrypt plaintext",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "TrentService.Encrypt", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"KeyId\":\"{{captures.key_id}}\",\"Plaintext\":\"aGVsbG8gZnJvbSBzdHVkaW8=\"}"
          },
          "captures": [{ "name": "ciphertext_blob", "source": "CiphertextBlob" }],
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        },
        {
          "id": "decrypt",
          "title": "Decrypt ciphertext",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "TrentService.Decrypt", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"CiphertextBlob\":\"{{captures.ciphertext_blob}}\"}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }],
          "error_guidance": "Decrypt failed — verify the ciphertext from the encrypt step was captured correctly."
        },
        {
          "id": "describe-key",
          "title": "Describe key",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "TrentService.DescribeKey", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"KeyId\":\"{{captures.key_id}}\"}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        }
      ],
      "cleanup": [
        {
          "id": "schedule-deletion",
          "title": "Schedule key deletion",
          "operation": {
            "method": "POST",
            "path": "/",
            "headers": { "x-amz-target": "TrentService.ScheduleKeyDeletion", "content-type": "application/x-amz-json-1.1" },
            "body": "{\"KeyId\":\"{{captures.key_id}}\",\"PendingWindowInDays\":7}"
          },
          "assertions": [{ "kind": "status", "target": "status", "expected": "200" }]
        }
      ]
    }
  ]
}
