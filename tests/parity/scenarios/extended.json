  {
    "id": "kms-sign",
    "profile": "extended",
    "service": "kms",
    "setup": [
      {
        "id": "create-kms-key",
        "protocol": "json-1.1",
        "command": ["kms", "create-key", "--description", "parity-sign-key"],
        "expect_success": true,
        "capture_json": "key_meta"
      }
    ],
    "steps": [
      {
        "id": "sign-message",
        "protocol": "json-1.1",
        "command": [
          "kms", "sign",
          "--key-id", "${key_meta.KeyMetadata.KeyId}",
          "--message", "aGVsbG8=",
          "--message-type", "RAW",
          "--signing-algorithm", "RSASSA_PKCS1_V1_5_SHA_256"
        ],
        "expect_success": true,
        "capture_json": "sign_result"
      }
    ],
    "assertions": [
      { "path": "sign_result.Signature", "not_empty": true },
      { "path": "sign_result.SigningAlgorithm", "equals": "RSASSA_PKCS1_V1_5_SHA_256" }
    ],
    "cleanup": []
  },

  {
    "id": "kms-verify",
    "profile": "extended",
    "service": "kms",
    "setup": [
      {
        "id": "create-kms-key-verify",
        "protocol": "json-1.1",
        "command": ["kms", "create-key", "--description", "parity-verify-key"],
        "expect_success": true,
        "capture_json": "key_meta"
      },
      {
        "id": "sign-for-verify",
        "protocol": "json-1.1",
        "command": [
          "kms", "sign",
          "--key-id", "${key_meta.KeyMetadata.KeyId}",
          "--message", "aGVsbG8=",
          "--message-type", "RAW",
          "--signing-algorithm", "RSASSA_PKCS1_V1_5_SHA_256"
        ],
        "expect_success": true,
        "capture_json": "sign_result"
      }
    ],
    "steps": [
      {
        "id": "verify-signature",
        "protocol": "json-1.1",
        "command": [
          "kms", "verify",
          "--key-id", "${key_meta.KeyMetadata.KeyId}",
          "--message", "aGVsbG8=",
          "--message-type", "RAW",
          "--signing-algorithm", "RSASSA_PKCS1_V1_5_SHA_256",
          "--signature", "${sign_result.Signature}"
        ],
        "expect_success": true,
        "capture_json": "verify_result"
      }
    ],
    "assertions": [
      { "path": "verify_result.SignatureValid", "equals": true }
    ],
    "cleanup": []
  },

