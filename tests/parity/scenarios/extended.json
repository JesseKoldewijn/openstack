  {
    "id": "lambda-add-permission",
    "profile": "extended",
    "service": "lambda",
    "setup": [
      {
        "id": "create-function-for-policy",
        "protocol": "rest-json",
        "command": [
          "lambda", "create-function",
          "--function-name", "policy-test-fn",
          "--runtime", "python3.11",
          "--role", "arn:aws:iam::000000000000:role/exec",
          "--handler", "index.handler",
          "--zip-file", "fileb:///dev/null"
        ],
        "expect_success": true,
        "capture_json": null
      }
    ],
    "steps": [
      {
        "id": "add-permission",
        "protocol": "rest-json",
        "command": [
          "lambda", "add-permission",
          "--function-name", "policy-test-fn",
          "--statement-id", "AllowS3Invoke",
          "--action", "lambda:InvokeFunction",
          "--principal", "s3.amazonaws.com"
        ],
        "expect_success": true,
        "capture_json": "add_result"
      },
      {
        "id": "get-policy",
        "protocol": "rest-json",
        "command": ["lambda", "get-policy", "--function-name", "policy-test-fn"],
        "expect_success": true,
        "capture_json": "policy_result"
      }
    ],
    "assertions": [
      { "path": "policy_result.Policy", "contains": "AllowS3Invoke" }
    ],
    "cleanup": [
      {
        "id": "delete-function-for-policy",
        "protocol": "rest-json",
        "command": ["lambda", "delete-function", "--function-name", "policy-test-fn"],
        "expect_success": true,
        "capture_json": null
      }
    ]
  },

